{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Easylsp release v3",
  "type": "object",
  "required": [
    "formatVersion",
    "catalogPluginId",
    "publisherId",
    "releaseId",
    "versionCode",
    "versionName",
    "name",
    "description",
    "license",
    "sourceUrl",
    "channel",
    "changelog",
    "publishedAt",
    "runtime",
    "pluginAbi",
    "sdkVersion",
    "minHostVersion",
    "requiredCapabilities",
    "artifacts",
    "target"
  ],
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "catalogPluginId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "publisherId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "changelog": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "enum": [
        "NATIVE",
        "BEANSHELL",
        "JAVA_NATIVE"
      ]
    },
    "pluginAbi": {
      "const": 1
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1
    },
    "minHostVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "native.symbol",
          "native.elf-vaddr",
          "native.module-lifecycle",
          "native.chain",
          "native.jni-register",
          "native.intercept",
          "native.plt",
          "native.runtime-register",
          "java.beanshell",
          "release.joint",
          "release.dependencies"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "abi",
          "minApi",
          "artifactPath"
        ],
        "properties": {
          "abi": {
            "enum": [
              "arm64-v8a",
              "any"
            ]
          },
          "minApi": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36
          },
          "artifactPath": {
            "enum": [
              "native/arm64-v8a/plugin.so",
              "java/main.java"
            ]
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "packageName",
        "processScope"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "processScope": {
          "enum": [
            "main",
            "children",
            "all",
            "exact"
          ]
        },
        "processName": {
          "type": "string"
        },
        "minVersionCode": {
          "type": "integer",
          "minimum": 0
        },
        "maxVersionCode": {
          "type": "integer",
          "minimum": 0
        },
        "processType": {
          "enum": [
            "app",
            "isolated",
            "app_zygote"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "version",
        "schemaPath",
        "defaults"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "schemaPath": {
          "const": "config.schema.json"
        },
        "defaults": {
          "type": "object"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "publisherId",
          "catalogPluginId",
          "releaseId"
        ],
        "additionalProperties": false,
        "properties": {
          "publisherId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "catalogPluginId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "releaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "JAVA_NATIVE"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "artifactPath": {
                      "const": "native/arm64-v8a/plugin.so"
                    },
                    "abi": {
                      "const": "arm64-v8a"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "artifactPath": {
                      "const": "java/main.java"
                    },
                    "abi": {
                      "const": "any"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "NATIVE"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "artifactPath": {
                  "const": "native/arm64-v8a/plugin.so"
                },
                "abi": {
                  "const": "arm64-v8a"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "BEANSHELL"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "artifactPath": {
                  "const": "java/main.java"
                },
                "abi": {
                  "const": "any"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "processType": {
                "enum": [
                  "isolated",
                  "app_zygote"
                ]
              }
            },
            "required": [
              "processType"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "const": "NATIVE"
          },
          "target": {
            "properties": {
              "processScope": {
                "const": "exact"
              }
            }
          }
        }
      }
    }
  ]
}
